---
import { ArrowUpRight } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { friendLinks } from "../lib/friend-links";
---

<BaseLayout title="友链" description="朋友的站点。" wide>
  <header class="page-header">
    <p class="eyebrow">Links</p>
    <h1>友链</h1>
  </header>

  {
    friendLinks.length > 0 ? (
      <ul class="link-grid">
        {friendLinks.map((link) => (
          <li>
            <a href={link.url} title={link.description}>
              {link.avatar ? (
                <img
                  class="link-avatar"
                  src={link.avatar}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                />
              ) : (
                <span class="link-avatar link-fallback" aria-hidden="true">
                  {link.name.slice(0, 1)}
                </span>
              )}
              <span class="link-name">{link.name}</span>
              <ArrowUpRight size={15} stroke-width={1.8} class="link-arrow" aria-hidden="true" />
              {link.description && <small class="link-desc">{link.description}</small>}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-state">这里还没有友链。</p>
    )
  }
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 42px;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .link-grid a {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 12px;
    row-gap: 6px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 160ms ease, background 160ms ease;
  }

  .link-grid a:hover {
    border-color: var(--border-strong);
    background: var(--surface);
  }

  .link-avatar {
    grid-row: 1 / 3;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 9999px;
    object-fit: cover;
  }

  .link-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    background: var(--surface-raised);
    font-weight: 650;
  }

  .link-name {
    overflow: hidden;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 650;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-grid a:hover .link-name {
    color: var(--accent-strong);
  }

  .link-arrow {
    color: var(--faint);
    opacity: 0;
    transition: opacity 160ms ease, color 160ms ease;
  }

  .link-grid a:hover .link-arrow {
    color: var(--text);
    opacity: 1;
  }

  .link-desc {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .link-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    }
  }
</style>
