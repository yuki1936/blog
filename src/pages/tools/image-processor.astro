---
import { Archive, Crop, Download, Grid3x3, ImageDown, Upload } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="图片处理" description="在浏览器本地裁切、缩放和压缩图片。" wide>
  <header class="tool-header">
    <p class="eyebrow">Tools / Image Processor</p>
    <h1>图片处理</h1>
    <p class="lede">图片不会离开当前设备。</p>
  </header>

  <label class="upload-zone" id="upload-zone" for="image-input">
    <Upload size={22} stroke-width={1.6} aria-hidden="true" />
    <span><strong>选择图片</strong><small>或拖放到这里</small></span>
    <input id="image-input" type="file" accept="image/*" />
  </label>

  <div class="image-workspace" id="image-workspace" hidden>
    <section class="source-panel" aria-label="裁切区域">
      <div class="image-stage">
        <div class="image-frame" id="image-frame">
          <img id="source-image" alt="待处理图片预览" draggable="false" />
          <div class="crop-selection" id="crop-selection" aria-hidden="true"></div>
          <div class="grid-overlay" id="grid-overlay" aria-hidden="true" hidden></div>
        </div>
      </div>
      <p class="stage-caption" id="stage-caption">拖动图片上的区域进行裁切</p>
    </section>

    <aside class="image-controls">
      <fieldset>
        <legend>处理方式</legend>
        <div class="mode-switch" aria-label="处理方式">
          <button type="button" data-mode="crop" aria-pressed="true">
            <Crop size={16} aria-hidden="true" /> 裁切
          </button>
          <button type="button" data-mode="split" aria-pressed="false">
            <Grid3x3 size={16} aria-hidden="true" /> 等分
          </button>
        </div>
      </fieldset>

      <fieldset id="crop-controls">
        <legend>裁切区域</legend>
        <div class="control-grid crop-fields">
          <label class="field-label">X <input class="field" id="crop-x" type="number" min="0" /></label>
          <label class="field-label">Y <input class="field" id="crop-y" type="number" min="0" /></label>
          <label class="field-label">宽度 <input class="field" id="crop-width" type="number" min="1" /></label>
          <label class="field-label">高度 <input class="field" id="crop-height" type="number" min="1" /></label>
        </div>
      </fieldset>

      <fieldset id="split-controls" hidden>
        <legend>切片网格</legend>
        <div class="grid-presets" aria-label="常用网格">
          <button type="button" data-grid="2">2 × 2</button>
          <button type="button" data-grid="3">3 × 3</button>
          <button type="button" data-grid="4">4 × 4</button>
        </div>
        <div class="control-grid split-fields">
          <label class="field-label">行数 <input class="field" id="split-rows" type="number" min="1" max="10" value="2" /></label>
          <label class="field-label">列数 <input class="field" id="split-columns" type="number" min="1" max="10" value="2" /></label>
        </div>
        <p class="field-note">最多生成 100 个切片。</p>
      </fieldset>

      <fieldset>
        <legend>输出</legend>
        <div class="output-fields">
          <label class="field-label">
            <span id="output-width-label">最大宽度</span>
            <input class="field" id="output-width" type="number" min="1" placeholder="保持原尺寸" />
          </label>
          <label class="field-label">
            格式
            <select class="select" id="output-format">
              <option value="image/webp">WebP</option>
              <option value="image/jpeg">JPEG</option>
              <option value="image/png">PNG</option>
            </select>
          </label>
          <label class="field-label quality-field">
            <span>质量 <output id="quality-value">82%</output></span>
            <input id="output-quality" type="range" min="10" max="100" value="82" />
          </label>
        </div>
      </fieldset>

      <button class="tool-button primary process-button" id="process-image" type="button">
        <ImageDown size={18} aria-hidden="true" /> <span id="process-label">生成图片</span>
      </button>
      <p id="image-status" class="status-line" aria-live="polite"></p>
    </aside>
  </div>

  <section class="output-panel" id="output-panel" hidden>
    <div class="output-heading">
      <div>
        <h2>处理结果</h2>
        <p id="output-info"></p>
      </div>
      <a class="tool-button" id="download-image" download hidden>
        <Download size={17} aria-hidden="true" /> 下载
      </a>
      <a class="tool-button" id="download-slices" download hidden>
        <Archive size={17} aria-hidden="true" /> 下载 ZIP
      </a>
    </div>
    <div class="output-preview" id="single-output" hidden><img id="output-image" alt="处理后的图片预览" /></div>
    <div class="slice-results" id="slice-results" hidden></div>
  </section>
</BaseLayout>

<script>
  import { zipSync } from "fflate";
  import {
    calculateOutputSize,
    calculateSliceRegion,
    clamp,
    fileStem,
    formatBytes,
    imageExtension,
    normalizeGridSize,
  } from "../../lib/image-processing";

  interface CropArea {
    x: number;
    y: number;
    width: number;
    height: number;
  }

  type ProcessMode = "crop" | "split";

  const MAX_IMAGE_BYTES = 25 * 1024 * 1024;
  const MAX_IMAGE_PIXELS = 25_000_000;

  const fileInput = document.querySelector<HTMLInputElement>("#image-input");
  const uploadZone = document.querySelector<HTMLElement>("#upload-zone");
  const workspace = document.querySelector<HTMLElement>("#image-workspace");
  const frame = document.querySelector<HTMLElement>("#image-frame");
  const sourceImage = document.querySelector<HTMLImageElement>("#source-image");
  const selection = document.querySelector<HTMLElement>("#crop-selection");
  const gridOverlay = document.querySelector<HTMLElement>("#grid-overlay");
  const stageCaption = document.querySelector<HTMLElement>("#stage-caption");
  const status = document.querySelector<HTMLElement>("#image-status");
  const processButton = document.querySelector<HTMLButtonElement>("#process-image");
  const processLabel = document.querySelector<HTMLElement>("#process-label");
  const outputPanel = document.querySelector<HTMLElement>("#output-panel");
  const singleOutput = document.querySelector<HTMLElement>("#single-output");
  const outputImage = document.querySelector<HTMLImageElement>("#output-image");
  const outputInfo = document.querySelector<HTMLElement>("#output-info");
  const downloadLink = document.querySelector<HTMLAnchorElement>("#download-image");
  const downloadSlices = document.querySelector<HTMLAnchorElement>("#download-slices");
  const sliceResults = document.querySelector<HTMLElement>("#slice-results");
  const formatInput = document.querySelector<HTMLSelectElement>("#output-format");
  const qualityInput = document.querySelector<HTMLInputElement>("#output-quality");
  const qualityValue = document.querySelector<HTMLOutputElement>("#quality-value");
  const maxWidthInput = document.querySelector<HTMLInputElement>("#output-width");
  const maxWidthLabel = document.querySelector<HTMLElement>("#output-width-label");
  const cropControls = document.querySelector<HTMLElement>("#crop-controls");
  const splitControls = document.querySelector<HTMLElement>("#split-controls");
  const splitRows = document.querySelector<HTMLInputElement>("#split-rows");
  const splitColumns = document.querySelector<HTMLInputElement>("#split-columns");
  const modeButtons = document.querySelectorAll<HTMLButtonElement>("[data-mode]");
  const presetButtons = document.querySelectorAll<HTMLButtonElement>("[data-grid]");
  const cropInputs = {
    x: document.querySelector<HTMLInputElement>("#crop-x"),
    y: document.querySelector<HTMLInputElement>("#crop-y"),
    width: document.querySelector<HTMLInputElement>("#crop-width"),
    height: document.querySelector<HTMLInputElement>("#crop-height"),
  };

  let sourceUrl = "";
  let outputUrl = "";
  let zipUrl = "";
  let sliceUrls: string[] = [];
  let sourceFile: File | null = null;
  let processMode: ProcessMode = "crop";
  let crop: CropArea = { x: 0, y: 0, width: 1, height: 1 };
  let dragStart: { x: number; y: number } | null = null;

  function setStatus(message: string, state = "") {
    if (!status) return;
    status.textContent = message;
    status.dataset.state = state;
  }

  function updateCropInputs() {
    for (const key of Object.keys(cropInputs) as (keyof CropArea)[]) {
      const input = cropInputs[key];
      if (input) input.value = String(Math.round(crop[key]));
    }
  }

  function updateSelection() {
    if (!sourceImage || !selection || !sourceImage.naturalWidth) return;
    const scaleX = sourceImage.clientWidth / sourceImage.naturalWidth;
    const scaleY = sourceImage.clientHeight / sourceImage.naturalHeight;
    selection.style.left = `${crop.x * scaleX}px`;
    selection.style.top = `${crop.y * scaleY}px`;
    selection.style.width = `${crop.width * scaleX}px`;
    selection.style.height = `${crop.height * scaleY}px`;
  }

  function setCrop(next: CropArea) {
    if (!sourceImage?.naturalWidth) return;
    const maxX = sourceImage.naturalWidth;
    const maxY = sourceImage.naturalHeight;
    const x = clamp(Math.round(next.x), 0, maxX - 1);
    const y = clamp(Math.round(next.y), 0, maxY - 1);
    crop = {
      x,
      y,
      width: clamp(Math.round(next.width), 1, maxX - x),
      height: clamp(Math.round(next.height), 1, maxY - y),
    };
    updateCropInputs();
    updateSelection();
  }

  function getGridSize() {
    const rows = normalizeGridSize(splitRows?.value);
    const columns = normalizeGridSize(splitColumns?.value);
    if (splitRows) splitRows.value = String(rows);
    if (splitColumns) splitColumns.value = String(columns);
    return { rows, columns };
  }

  function updateGridOverlay() {
    if (!gridOverlay) return;
    const { rows, columns } = getGridSize();
    gridOverlay.style.setProperty("--grid-rows", String(rows));
    gridOverlay.style.setProperty("--grid-columns", String(columns));
    gridOverlay.style.setProperty("--grid-row-size", `${100 / rows}%`);
    gridOverlay.style.setProperty("--grid-column-size", `${100 / columns}%`);
    if (stageCaption && processMode === "split") {
      stageCaption.textContent = `整张图片将切成 ${rows} × ${columns}，共 ${rows * columns} 片`;
    }
  }

  function clearOutput() {
    if (outputUrl) URL.revokeObjectURL(outputUrl);
    if (zipUrl) URL.revokeObjectURL(zipUrl);
    for (const url of sliceUrls) URL.revokeObjectURL(url);
    outputUrl = "";
    zipUrl = "";
    sliceUrls = [];
    if (outputImage) outputImage.removeAttribute("src");
    if (downloadLink) {
      downloadLink.removeAttribute("href");
      downloadLink.hidden = true;
    }
    if (downloadSlices) {
      downloadSlices.removeAttribute("href");
      downloadSlices.hidden = true;
    }
    if (sliceResults) {
      sliceResults.replaceChildren();
      sliceResults.hidden = true;
    }
    if (singleOutput) singleOutput.hidden = true;
    if (outputPanel) outputPanel.hidden = true;
  }

  function setProcessMode(mode: ProcessMode) {
    processMode = mode;
    for (const button of modeButtons) {
      button.setAttribute("aria-pressed", String(button.dataset.mode === mode));
    }
    if (cropControls) cropControls.hidden = mode !== "crop";
    if (splitControls) splitControls.hidden = mode !== "split";
    if (selection) selection.hidden = mode !== "crop";
    if (gridOverlay) gridOverlay.hidden = mode !== "split";
    if (processLabel) processLabel.textContent = mode === "crop" ? "生成图片" : "生成切片";
    if (maxWidthLabel) maxWidthLabel.textContent = mode === "crop" ? "最大宽度" : "单片最大宽度";
    if (stageCaption) {
      stageCaption.textContent = mode === "crop" ? "拖动图片上的区域进行裁切" : "";
    }
    updateGridOverlay();
    clearOutput();
  }

  function canvasToBlob(canvas: HTMLCanvasElement, mime: string, quality: number) {
    return new Promise<Blob>((resolve, reject) => {
      canvas.toBlob(
        (blob) => (blob ? resolve(blob) : reject(new Error("无法生成图片"))),
        mime,
        quality,
      );
    });
  }

  function rejectSource(message: string) {
    sourceFile = null;
    if (sourceUrl) URL.revokeObjectURL(sourceUrl);
    sourceUrl = "";
    if (sourceImage) {
      sourceImage.onload = null;
      sourceImage.onerror = null;
      sourceImage.removeAttribute("src");
    }
    if (fileInput) fileInput.value = "";
    if (workspace) workspace.hidden = true;
    clearOutput();
    setStatus(message, "error");
  }

  function loadFile(file: File) {
    if (!file.type.startsWith("image/")) {
      return rejectSource("请选择有效的图片文件");
    }
    if (file.size > MAX_IMAGE_BYTES) return rejectSource("图片不能超过 25 MiB");
    sourceFile = file;
    if (sourceUrl) URL.revokeObjectURL(sourceUrl);
    sourceUrl = URL.createObjectURL(file);
    if (!sourceImage) return;
    sourceImage.src = sourceUrl;
    sourceImage.onload = () => {
      const pixelCount = sourceImage.naturalWidth * sourceImage.naturalHeight;
      if (!Number.isSafeInteger(pixelCount) || pixelCount > MAX_IMAGE_PIXELS) {
        rejectSource("图片不能超过 2500 万像素");
        return;
      }
      if (workspace) workspace.hidden = false;
      setCrop({
        x: 0,
        y: 0,
        width: sourceImage.naturalWidth,
        height: sourceImage.naturalHeight,
      });
      if (maxWidthInput) maxWidthInput.placeholder = String(sourceImage.naturalWidth);
      clearOutput();
      updateGridOverlay();
      setStatus(`${sourceImage.naturalWidth} × ${sourceImage.naturalHeight} · ${formatBytes(file.size)}`);
    };
    sourceImage.onerror = () => rejectSource("无法读取这张图片");
  }

  fileInput?.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    if (file) loadFile(file);
  });

  for (const eventName of ["dragenter", "dragover"]) {
    uploadZone?.addEventListener(eventName, (event) => {
      event.preventDefault();
      uploadZone.dataset.dragging = "true";
    });
  }

  for (const eventName of ["dragleave", "drop"]) {
    uploadZone?.addEventListener(eventName, (event) => {
      event.preventDefault();
      delete uploadZone.dataset.dragging;
    });
  }

  uploadZone?.addEventListener("drop", (event) => {
    const file = event.dataTransfer?.files[0];
    if (file) loadFile(file);
  });

  for (const button of modeButtons) {
    button.addEventListener("click", () => {
      const mode = button.dataset.mode;
      if (mode === "crop" || mode === "split") setProcessMode(mode);
    });
  }

  for (const button of presetButtons) {
    button.addEventListener("click", () => {
      const size = clamp(Number(button.dataset.grid) || 2, 1, 10);
      if (splitRows) splitRows.value = String(size);
      if (splitColumns) splitColumns.value = String(size);
      updateGridOverlay();
      clearOutput();
    });
  }

  for (const input of [splitRows, splitColumns]) {
    input?.addEventListener("change", () => {
      updateGridOverlay();
      clearOutput();
    });
  }

  function pointInImage(event: PointerEvent) {
    if (!sourceImage) return { x: 0, y: 0 };
    const rect = sourceImage.getBoundingClientRect();
    return {
      x: clamp(event.clientX - rect.left, 0, rect.width),
      y: clamp(event.clientY - rect.top, 0, rect.height),
    };
  }

  frame?.addEventListener("pointerdown", (event) => {
    if (processMode !== "crop" || !sourceImage?.naturalWidth) return;
    frame.setPointerCapture(event.pointerId);
    dragStart = pointInImage(event);
    const scaleX = sourceImage.naturalWidth / sourceImage.clientWidth;
    const scaleY = sourceImage.naturalHeight / sourceImage.clientHeight;
    setCrop({
      x: dragStart.x * scaleX,
      y: dragStart.y * scaleY,
      width: 1,
      height: 1,
    });
  });

  frame?.addEventListener("pointermove", (event) => {
    if (!dragStart || !sourceImage?.naturalWidth) return;
    const point = pointInImage(event);
    const left = Math.min(dragStart.x, point.x);
    const top = Math.min(dragStart.y, point.y);
    const scaleX = sourceImage.naturalWidth / sourceImage.clientWidth;
    const scaleY = sourceImage.naturalHeight / sourceImage.clientHeight;
    setCrop({
      x: left * scaleX,
      y: top * scaleY,
      width: Math.max(1, Math.abs(point.x - dragStart.x) * scaleX),
      height: Math.max(1, Math.abs(point.y - dragStart.y) * scaleY),
    });
  });

  function endDrag() {
    dragStart = null;
  }

  frame?.addEventListener("pointerup", endDrag);
  frame?.addEventListener("pointercancel", endDrag);

  for (const key of Object.keys(cropInputs) as (keyof CropArea)[]) {
    cropInputs[key]?.addEventListener("change", () => {
      setCrop({
        x: Number(cropInputs.x?.value ?? crop.x),
        y: Number(cropInputs.y?.value ?? crop.y),
        width: Number(cropInputs.width?.value ?? crop.width),
        height: Number(cropInputs.height?.value ?? crop.height),
      });
    });
  }

  qualityInput?.addEventListener("input", () => {
    if (qualityValue) qualityValue.value = `${qualityInput.value}%`;
  });

  formatInput?.addEventListener("change", () => {
    if (qualityInput) qualityInput.disabled = formatInput.value === "image/png";
  });

  new ResizeObserver(updateSelection).observe(frame ?? document.body);

  async function renderRegion(
    x: number,
    y: number,
    width: number,
    height: number,
    mime: string,
    quality: number,
  ) {
    const outputSize = calculateOutputSize(
      width,
      height,
      Number(maxWidthInput?.value),
    );
    const canvas = document.createElement("canvas");
    canvas.width = outputSize.width;
    canvas.height = outputSize.height;
    const context = canvas.getContext("2d");
    if (!context) throw new Error("当前浏览器不支持 Canvas");

    context.drawImage(
      sourceImage!,
      x,
      y,
      width,
      height,
      0,
      0,
      outputSize.width,
      outputSize.height,
    );
    const blob = await canvasToBlob(canvas, mime, quality);
    return { blob, ...outputSize };
  }

  processButton?.addEventListener("click", async () => {
    if (!sourceImage?.naturalWidth || !sourceFile || !processButton) return;
    const currentFile = sourceFile;
    const mime = formatInput?.value ?? "image/webp";
    const quality = Number(qualityInput?.value ?? 82) / 100;
    const extension = imageExtension(mime);
    const baseName = fileStem(currentFile.name);
    clearOutput();
    processButton.disabled = true;

    try {
      if (processMode === "crop") {
        setStatus("正在生成…");
        const result = await renderRegion(
          crop.x,
          crop.y,
          crop.width,
          crop.height,
          mime,
          quality,
        );
        if (!outputImage || !downloadLink || !outputInfo || !outputPanel || !singleOutput) {
          throw new Error("无法显示处理结果");
        }
        outputUrl = URL.createObjectURL(result.blob);
        outputImage.src = outputUrl;
        downloadLink.href = outputUrl;
        downloadLink.download = `${baseName}-processed.${extension}`;
        downloadLink.hidden = false;
        singleOutput.hidden = false;
        outputInfo.textContent = `${result.width} × ${result.height} · ${formatBytes(result.blob.size)}`;
        outputPanel.hidden = false;
        setStatus("图片已生成", "success");
      } else {
        const { rows, columns } = getGridSize();
        if (rows * columns > 100) throw new Error("最多生成 100 个切片");
        if (rows > sourceImage.naturalHeight || columns > sourceImage.naturalWidth) {
          throw new Error("行列数不能超过图片的像素尺寸");
        }
        if (!sliceResults || !downloadSlices || !outputInfo || !outputPanel) {
          throw new Error("无法显示切片结果");
        }

        setStatus(`正在生成 ${rows * columns} 个切片…`);
        const zipFiles: Record<string, Uint8Array> = {};
        let totalSize = 0;

        for (let row = 0; row < rows; row += 1) {
          for (let column = 0; column < columns; column += 1) {
            const region = calculateSliceRegion(
              sourceImage.naturalWidth,
              sourceImage.naturalHeight,
              rows,
              columns,
              row,
              column,
            );
            const result = await renderRegion(
              region.x,
              region.y,
              region.width,
              region.height,
              mime,
              quality,
            );
            const rowName = String(row + 1).padStart(2, "0");
            const columnName = String(column + 1).padStart(2, "0");
            const filename = `${baseName}-r${rowName}-c${columnName}.${extension}`;
            const url = URL.createObjectURL(result.blob);
            sliceUrls.push(url);
            totalSize += result.blob.size;
            zipFiles[filename] = new Uint8Array(await result.blob.arrayBuffer());

            const card = document.createElement("article");
            card.className = "slice-card";
            const preview = document.createElement("div");
            preview.className = "slice-preview";
            const image = document.createElement("img");
            image.src = url;
            image.alt = `第 ${row + 1} 行第 ${column + 1} 列切片`;
            preview.append(image);

            const details = document.createElement("div");
            details.className = "slice-details";
            const label = document.createElement("span");
            label.textContent = `${row + 1}, ${column + 1} · ${result.width} × ${result.height}`;
            const link = document.createElement("a");
            link.href = url;
            link.download = filename;
            link.textContent = "下载";
            details.append(label, link);
            card.append(preview, details);
            sliceResults.append(card);
          }
        }

        const archive = zipSync(zipFiles, { level: 0 });
        zipUrl = URL.createObjectURL(new Blob([archive], { type: "application/zip" }));
        downloadSlices.href = zipUrl;
        downloadSlices.download = `${baseName}-${rows}x${columns}.zip`;
        downloadSlices.hidden = false;
        sliceResults.hidden = false;
        outputInfo.textContent = `${rows} × ${columns} · ${rows * columns} 个切片 · ${formatBytes(totalSize)}`;
        outputPanel.hidden = false;
        setStatus(`${rows * columns} 个切片已生成`, "success");
      }

      outputPanel?.scrollIntoView({ behavior: "smooth", block: "start" });
    } catch (error) {
      clearOutput();
      setStatus(error instanceof Error ? error.message : "无法生成图片", "error");
    } finally {
      processButton.disabled = false;
    }
  });
</script>

<style>
  [hidden] {
    display: none !important;
  }

  .tool-header {
    margin-bottom: 34px;
  }

  .upload-zone {
    display: flex;
    min-height: 84px;
    align-items: center;
    justify-content: center;
    gap: 14px;
    border: 1px dashed var(--border-strong);
    border-radius: 6px;
    color: var(--accent);
    background: var(--surface);
    cursor: pointer;
  }

  .upload-zone:hover,
  .upload-zone[data-dragging="true"] {
    border-color: var(--accent);
    background: var(--surface-raised);
  }

  .upload-zone span {
    display: grid;
  }

  .upload-zone strong {
    color: var(--text);
    font-size: 0.9rem;
  }

  .upload-zone small {
    color: var(--muted);
    font-size: 0.76rem;
  }

  .upload-zone input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .image-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 24px;
    margin-top: 24px;
  }

  .image-stage {
    display: grid;
    min-height: 500px;
    place-items: center;
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: 5px;
    background-color: #0b0d0c;
    background-image:
      linear-gradient(45deg, #161916 25%, transparent 25%),
      linear-gradient(-45deg, #161916 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, #161916 75%),
      linear-gradient(-45deg, transparent 75%, #161916 75%);
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    background-size: 16px 16px;
  }

  .image-frame {
