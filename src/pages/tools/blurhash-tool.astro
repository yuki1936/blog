---
import {
  ChevronsLeftRight,
  Copy,
  Download,
  ImageUp,
  ScanLine,
} from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="BlurHash 编解码"
  description="在浏览器本地编码、解码并预览 BlurHash 图片占位图。"
  wide
>
  <header class="tool-header">
    <p class="eyebrow">Tools / BlurHash Tool</p>
    <h1>BlurHash 编解码</h1>
    <p class="lede">图片不会离开当前设备。</p>
  </header>

  <label class="upload-zone" id="blurhash-drop-zone" for="blurhash-file">
    <ImageUp size={22} stroke-width={1.6} aria-hidden="true" />
    <span><strong>选择图片</strong><small>或拖放到这里</small></span>
    <input id="blurhash-file" type="file" accept="image/*" />
  </label>

  <div class="blurhash-workspace">
    <section class="preview-panel" aria-label="BlurHash 图片预览">
      <div class="preview-toolbar">
        <div class="mode-switch" role="group" aria-label="预览模式">
          <button type="button" data-view="original" aria-pressed="false">原图</button>
          <button type="button" data-view="blur" aria-pressed="false">占位图</button>
          <button type="button" data-view="compare" aria-pressed="true">对比</button>
        </div>
        <span id="blurhash-decoded-size">64 × 42 px</span>
      </div>

      <div class="image-stage">
        <div id="blurhash-preview" class="preview" data-view="compare">
          <canvas id="blurhash-canvas" aria-label="BlurHash 占位图"></canvas>
          <canvas id="blurhash-source" aria-label="原图"></canvas>
          <div id="blurhash-divider" class="divider" aria-hidden="true">
            <span><ChevronsLeftRight size={16} aria-hidden="true" /></span>
          </div>
        </div>
      </div>

      <input
        id="blurhash-compare"
        class="compare-range"
        type="range"
        min="0"
        max="100"
        value="52"
        aria-label="原图与占位图对比位置"
      />
      <div class="stage-caption">
        <span>编码输入 <b id="blurhash-source-size">160 × 104</b></span>
        <span>占位图按原图比例显示</span>
      </div>
    </section>

    <aside class="blurhash-controls" aria-label="BlurHash 参数">
      <fieldset>
        <legend>编码参数</legend>
        <div class="control-grid">
          <label class="field-label">
            横向分量
            <input class="field" id="blurhash-components-x" type="number" min="1" max="9" value="4" />
          </label>
          <label class="field-label">
            纵向分量
            <input class="field" id="blurhash-components-y" type="number" min="1" max="9" value="3" />
          </label>
        </div>
        <div class="metric-line">
          <span><b id="blurhash-char-count">28</b> 字符</span>
          <span><b id="blurhash-component-count">12</b> 分量</span>
          <span id="blurhash-encode-time">0 ms</span>
        </div>
      </fieldset>

      <fieldset>
        <legend>BlurHash</legend>
        <label class="hash-field">
          <textarea
            class="textarea"
            id="blurhash-value"
            rows="3"
            spellcheck="false"
            aria-label="BlurHash 字符串"></textarea>
          <button
            id="blurhash-copy"
            class="icon-button"
            type="button"
            title="复制 BlurHash"
            aria-label="复制 BlurHash"
          >
            <Copy size={17} aria-hidden="true" />
          </button>
        </label>
        <button id="blurhash-decode" class="tool-button full-width" type="button">
          <ScanLine size={17} aria-hidden="true" /> 解码此 Hash
        </button>
        <p id="blurhash-error" class="status-line error" role="alert" hidden></p>
      </fieldset>

      <fieldset>
        <legend>解码输出</legend>
        <div class="control-grid">
          <label class="field-label">
            宽度
            <input class="field" id="blurhash-width" type="number" min="1" max="2048" value="64" />
          </label>
          <label class="field-label">
            高度
            <input class="field" id="blurhash-height" type="number" min="1" max="2048" value="42" />
          </label>
        </div>
        <label class="range-field field-label">
          <span><span>色彩增强</span><output id="blurhash-punch-value">1.0</output></span>
          <input id="blurhash-punch" type="range" min="0" max="2" step="0.1" value="1" />
        </label>
      </fieldset>

      <button id="blurhash-download" class="tool-button primary full-width" type="button">
        <Download size={17} aria-hidden="true" /> 下载占位图
      </button>
      <p id="blurhash-status" class="status-line" data-state="success" aria-live="polite">
        内置样例
      </p>
    </aside>
  </div>
</BaseLayout>

<script>
  import { BlurHashError, decode, encode } from "../../lib/blurhash";

  type PreviewMode = "original" | "blur" | "compare";

  function element<T extends HTMLElement>(selector: string): T {
    const found = document.querySelector<T>(selector);
    if (!found) throw new Error(`Missing element ${selector}`);
    return found;
  }

  const sourceCanvas = element<HTMLCanvasElement>("#blurhash-source");
  const blurCanvas = element<HTMLCanvasElement>("#blurhash-canvas");
  const preview = element<HTMLElement>("#blurhash-preview");
  const hashInput = element<HTMLTextAreaElement>("#blurhash-value");
  const errorOutput = element<HTMLElement>("#blurhash-error");
  const status = element<HTMLElement>("#blurhash-status");
  const componentX = element<HTMLInputElement>("#blurhash-components-x");
  const componentY = element<HTMLInputElement>("#blurhash-components-y");
  const decodeWidth = element<HTMLInputElement>("#blurhash-width");
  const decodeHeight = element<HTMLInputElement>("#blurhash-height");
  const punch = element<HTMLInputElement>("#blurhash-punch");
  const compare = element<HTMLInputElement>("#blurhash-compare");
  const divider = element<HTMLElement>("#blurhash-divider");
  let view: PreviewMode = "compare";

  function setStatus(message: string, state: "success" | "error" = "success") {
    status.textContent = message;
    status.dataset.state = state;
  }

  function boundedInteger(input: HTMLInputElement, fallback: number): number {
    const value = Number(input.value);
    const minimum = Number(input.min);
    const maximum = Number(input.max);
    const result = Number.isFinite(value)
      ? Math.min(maximum, Math.max(minimum, Math.round(value)))
      : fallback;
    input.value = String(result);
    return result;
  }

  function drawSample() {
    sourceCanvas.width = 800;
    sourceCanvas.height = 520;
    const context = sourceCanvas.getContext("2d");
    if (!context) return;

    context.fillStyle = "#b9d9dc";
    context.fillRect(0, 0, 800, 520);
    context.fillStyle = "#e8c66a";
    context.beginPath();
    context.arc(660, 100, 62, 0, Math.PI * 2);
    context.fill();
    context.fillStyle = "#407d70";
    context.beginPath();
    context.moveTo(0, 310);
    context.bezierCurveTo(150, 210, 245, 350, 390, 260);
    context.bezierCurveTo(540, 170, 660, 300, 800, 205);
    context.lineTo(800, 520);
    context.lineTo(0, 520);
    context.fill();
    context.fillStyle = "#163e46";
    context.beginPath();
    context.moveTo(0, 400);
    context.bezierCurveTo(180, 300, 310, 440, 510, 330);
    context.bezierCurveTo(660, 250, 730, 365, 800, 315);
    context.lineTo(800, 520);
    context.lineTo(0, 520);
    context.fill();
    context.fillStyle = "#df654f";
    context.fillRect(116, 224, 108, 164);
    context.fillStyle = "#f6f1e5";
    context.beginPath();
    context.moveTo(92, 230);
    context.lineTo(170, 162);
    context.lineTo(248, 230);
    context.fill();
    context.fillStyle = "#29454b";
    context.fillRect(150, 310, 38, 78);
    syncSource("内置样例");
  }

  function syncSource(label: string) {
    const maximumSide = 160;
    const scale = Math.min(1, maximumSide / Math.max(sourceCanvas.width, sourceCanvas.height));
    const width = Math.max(1, Math.round(sourceCanvas.width * scale));
    const height = Math.max(1, Math.round(sourceCanvas.height * scale));
    const scratch = document.createElement("canvas");
    scratch.width = width;
    scratch.height = height;
    const context = scratch.getContext("2d", { willReadFrequently: true });
    if (!context) return;
    context.drawImage(sourceCanvas, 0, 0, width, height);

    const started = performance.now();
    hashInput.value = encode(
      context.getImageData(0, 0, width, height).data,
      width,
      height,
      boundedInteger(componentX, 4),
      boundedInteger(componentY, 3),
    );
    element("#blurhash-source-size").textContent = `${width} × ${height}`;
    element("#blurhash-encode-time").textContent =
      `${(performance.now() - started).toFixed(1)} ms`;
    element("#blurhash-component-count").textContent = String(
      boundedInteger(componentX, 4) * boundedInteger(componentY, 3),
    );
    preview.style.aspectRatio = `${sourceCanvas.width} / ${sourceCanvas.height}`;
    if (renderHash()) setStatus(label);
  }

  function renderHash(): boolean {
    try {
      const width = boundedInteger(decodeWidth, 64);
      const height = boundedInteger(decodeHeight, 42);
      if (width * height > 1_048_576) {
        throw new BlurHashError("解码输出不能超过 1,048,576 像素");
      }

      const pixels = decode(hashInput.value.trim(), width, height, Number(punch.value));
      blurCanvas.width = width;
      blurCanvas.height = height;
      const copy = new Uint8ClampedArray(pixels.length);
      copy.set(pixels);
      blurCanvas.getContext("2d")?.putImageData(new ImageData(copy, width, height), 0, 0);
      element("#blurhash-decoded-size").textContent = `${width} × ${height} px`;
      element("#blurhash-punch-value").textContent = Number(punch.value).toFixed(1);
      element("#blurhash-char-count").textContent = String(hashInput.value.trim().length);
      errorOutput.hidden = true;
      return true;
    } catch (error) {
      errorOutput.textContent =
        error instanceof BlurHashError ? error.message : "无法解码该 Hash";
      errorOutput.hidden = false;
      setStatus("Hash 无效", "error");
      return false;
    }
  }

  async function loadFile(file: File) {
    if (!file.type.startsWith("image/")) {
      setStatus("请选择图片文件", "error");
      return;
    }
    if (file.size > 25 * 1024 * 1024) {
      setStatus("图片不能超过 25 MiB", "error");
      return;
    }

    const objectUrl = URL.createObjectURL(file);
    try {
      const image = new Image();
      image.src = objectUrl;
      await image.decode();
      const maximumSide = 1600;
      const scale = Math.min(1, maximumSide / Math.max(image.naturalWidth, image.naturalHeight));
      sourceCanvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
      sourceCanvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
      sourceCanvas.getContext("2d")?.drawImage(image, 0, 0, sourceCanvas.width, sourceCanvas.height);
      syncSource(file.name);
    } catch {
      setStatus("无法读取图片", "error");
    } finally {
      URL.revokeObjectURL(objectUrl);
    }
  }

  function updateView() {
    preview.dataset.view = view;
    document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => {
      const active = button.dataset.view === view;
      button.classList.toggle("active", active);
      button.setAttribute("aria-pressed", String(active));
    });
    compare.hidden = view !== "compare";
    const position = Number(compare.value);
    sourceCanvas.style.clipPath = view === "compare" ? `inset(0 ${100 - position}% 0 0)` : "none";
    divider.style.left = `${position}%`;
  }

  element<HTMLInputElement>("#blurhash-file").addEventListener("change", (event) => {
    const file = (event.currentTarget as HTMLInputElement).files?.[0];
    if (file) void loadFile(file);
  });

  for (const input of [componentX, componentY]) {
    input.addEventListener("change", () => syncSource("参数已更新"));
  }
  for (const input of [decodeWidth, decodeHeight]) {
    input.addEventListener("change", () => {
      if (renderHash()) setStatus("输出尺寸已更新");
    });
  }
  hashInput.addEventListener("input", () => {
    element("#blurhash-char-count").textContent = String(hashInput.value.trim().length);
    errorOutput.hidden = true;
  });
  punch.addEventListener("input", () => {
    if (renderHash()) setStatus("色彩增强已更新");
  });
  element("#blurhash-decode").addEventListener("click", () => {
    if (renderHash()) setStatus("Hash 已解码");
  });
  element("#blurhash-copy").addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(hashInput.value.trim());
      setStatus("已复制 BlurHash");
    } catch {
      setStatus("无法访问剪贴板", "error");
    }
  });
  element("#blurhash-download").addEventListener("click", () => {
    if (!renderHash()) return;
    const link = document.createElement("a");
    link.download = "blurhash-placeholder.png";
    link.href = blurCanvas.toDataURL("image/png");
    link.click();
    setStatus("占位图已生成");
  });
  document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => {
    button.addEventListener("click", () => {
      view = button.dataset.view as PreviewMode;
      updateView();
    });
  });
  compare.addEventListener("input", updateView);

  const dropZone = element<HTMLElement>("#blurhash-drop-zone");
  for (const name of ["dragenter", "dragover"]) {
    dropZone.addEventListener(name, (event) => {
      event.preventDefault();
      dropZone.dataset.dragging = "true";
    });
  }
  for (const name of ["dragleave", "drop"]) {
    dropZone.addEventListener(name, (event) => {
      event.preventDefault();
      delete dropZone.dataset.dragging;
    });
  }
  dropZone.addEventListener("drop", (event) => {
    const file = event.dataTransfer?.files[0];
    if (file) void loadFile(file);
  });

  drawSample();
  updateView();
</script>

<style>
  .tool-header {
    margin-bottom: 34px;
  }

  .upload-zone {
    display: flex;
    min-height: 84px;
    align-items: center;
    justify-content: center;
    gap: 14px;
    border: 1px dashed var(--border-strong);
    border-radius: 6px;
    color: var(--accent);
    background: var(--surface);
    cursor: pointer;
  }

  .upload-zone:hover,
  .upload-zone[data-dragging="true"] {
    border-color: var(--accent);
    background: var(--surface-raised);
  }

  .upload-zone span {
    display: grid;
  }

  .upload-zone strong {
    color: var(--text);
    font-size: 0.9rem;
  }

  .upload-zone small {
    color: var(--muted);
    font-size: 0.76rem;
  }

  .upload-zone input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .blurhash-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 24px;
    margin-top: 24px;
  }

  .preview-panel {
    min-width: 0;
  }

  .preview-toolbar {
    display: flex;
    min-height: 44px;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .preview-toolbar > span {
    padding-top: 7px;
    color: var(--faint);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.73rem;
  }

  .mode-switch {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--surface);
  }

  .mode-switch button {
    display: inline-flex;
    min-width: 72px;
    min-height: 34px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 3px;
    color: var(--muted);
    background: transparent;
    cursor: pointer;
    font-size: 0.8rem;
  }

  .mode-switch button.active {
    color: var(--text);
    background: var(--surface-raised);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  .image-stage {
    display: grid;
    min-height: 500px;
    place-items: center;
    padding: 18px;
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: #0b0d0c;
  }

  .preview {
    position: relative;
    width: 100%;
    aspect-ratio: 20 / 13;
    overflow: hidden;
    background: #0b0d0c;
  }

  .preview canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .preview[data-view="original"] #blurhash-canvas,
  .preview[data-view="blur"] #blurhash-source {
    display: none;
  }

  .preview[data-view="original"] .divider,
  .preview[data-view="blur"] .divider {
    display: none;
  }

  .divider {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--accent-strong);
    box-shadow: 0 0 0 1px rgb(16 18 17 / 40%);
    pointer-events: none;
  }

  .divider span {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    transform: translate(-50%, -50%);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--accent-strong);
    background: var(--surface-raised);
  }

  .compare-range {
    width: 100%;
    height: 22px;
    margin-top: 8px;
    accent-color: var(--accent);
  }

  .stage-caption {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 4px;
    color: var(--faint);
    font-size: 0.72rem;
  }

  .stage-caption b {
    color: var(--muted);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-weight: 500;
  }

  .blurhash-controls {
    display: grid;
    align-content: start;
    gap: 20px;
  }

  .blurhash-controls fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .blurhash-controls legend {
    width: 100%;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 0.84rem;
    font-weight: 650;
  }

  .control-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .metric-line {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 9px;
    color: var(--faint);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.7rem;
  }

  .metric-line b {
    color: var(--muted);
    font-weight: 600;
  }

  .hash-field {
    position: relative;
    display: block;
  }

  .hash-field .textarea {
    min-height: 84px;
    padding: 11px 38px 11px 12px;
    overflow-wrap: anywhere;
    font-size: 0.78rem;
  }

  .icon-button {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 4px;
    color: var(--faint);
    background: transparent;
    cursor: pointer;
  }

  .icon-button:hover {
    color: var(--accent-strong);
    background: var(--surface-raised);
  }

  .hash-field .icon-button {
    position: absolute;
    top: 5px;
    right: 5px;
  }

  .full-width {
    width: 100%;
  }

  .hash-field + .tool-button {
    margin-top: 8px;
  }

  .range-field {
    margin-top: 12px;
  }

  .range-field > span {
    display: flex;
    justify-content: space-between;
  }

  .range-field output {
    color: var(--text);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.78rem;
  }

  .range-field input {
    width: 100%;
    accent-color: var(--accent);
  }

  .error {
    margin-top: 6px;
    overflow-wrap: anywhere;
  }

  @media (max-width: 820px) {
    .blurhash-workspace {
      grid-template-columns: 1fr;
    }

    .image-stage {
      min-height: 320px;
    }

    .blurhash-controls {
      margin-top: 18px;
    }
  }

  @media (max-width: 640px) {
    .stage-caption {
      display: grid;
      gap: 2px;
    }
  }

  @media (max-width: 440px) {
    .image-stage {
      min-height: 240px;
      padding: 10px;
    }

    .mode-switch button {
      min-width: 62px;
    }
  }
</style>
