---
import {
  Braces,
  Clipboard,
  Copy,
  Maximize2,
  Minimize2,
  Pencil,
  Play,
  Plus,
  Trash2,
} from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="JSON Viewer" description="查看 JSON 树并生成 Rust 或 Go 数据结构。" wide>
  <header class="tool-header">
    <p class="eyebrow">Tools / JSON Viewer</p>
    <h1>JSON Viewer</h1>
    <p class="lede">树形查看、节点编辑，以及 Rust 和 Go 类型生成。</p>
  </header>

  <div class="json-toolbar" role="toolbar" aria-label="JSON 操作">
    <button class="tool-button primary" id="json-parse" type="button">
      <Play size={17} aria-hidden="true" /> 解析
    </button>
    <button class="tool-button" id="json-copy-result" type="button">
      <Clipboard size={17} aria-hidden="true" /> 复制当前视图
    </button>
    <button class="tool-button" id="json-clear" type="button">
      <Trash2 size={17} aria-hidden="true" /> 清空
    </button>
    <p id="json-status" class="status-line" aria-live="polite">等待输入</p>
  </div>

  <div class="viewer-layout">
    <section class="input-panel">
      <label class="panel-label" for="json-input">JSON 输入</label>
      <textarea
        class="textarea"
        id="json-input"
        spellcheck="false"
        placeholder='{ "name": "neri", "languages": ["Rust", "Go"] }'></textarea>
      <div class="input-stats">
        <span id="json-characters">0 字符</span>
        <span id="json-lines">0 行</span>
      </div>
    </section>

    <section class="result-panel">
      <div class="result-tabs" role="tablist" aria-label="查看模式">
        <button class="view-tab active" type="button" role="tab" aria-selected="true" data-view="tree">
          树形视图
        </button>
        <button class="view-tab" type="button" role="tab" aria-selected="false" data-view="rust">
          Rust
        </button>
        <button class="view-tab" type="button" role="tab" aria-selected="false" data-view="go">
          Go
        </button>
      </div>

      <div class="tree-toolbar" id="tree-toolbar">
        <button type="button" id="expand-all" title="全部展开">
          <Maximize2 size={15} aria-hidden="true" /> 全部展开
        </button>
        <button type="button" id="collapse-all" title="全部折叠">
          <Minimize2 size={15} aria-hidden="true" /> 全部折叠
        </button>
        <span>右键节点可编辑</span>
      </div>

      <div class="viewer-pane tree-pane" id="tree-pane" role="tabpanel">
        <div class="viewer-empty" id="viewer-empty">
          <Braces size={24} stroke-width={1.5} aria-hidden="true" />
          <span>解析结果将在这里显示</span>
        </div>
        <div class="json-tree" id="json-tree" hidden></div>
      </div>

      <pre class="viewer-pane code-pane" id="rust-pane" role="tabpanel" hidden><code id="rust-output"></code></pre>
      <pre class="viewer-pane code-pane" id="go-pane" role="tabpanel" hidden><code id="go-output"></code></pre>
    </section>
  </div>

  <div class="context-menu" id="json-context-menu" role="menu" hidden>
    <button type="button" role="menuitem" data-action="edit">
      <Pencil size={15} aria-hidden="true" /> 编辑值
    </button>
    <button type="button" role="menuitem" data-action="add">
      <Plus size={15} aria-hidden="true" /> 添加
    </button>
    <button type="button" role="menuitem" data-action="copy">
      <Copy size={15} aria-hidden="true" /> 复制节点
    </button>
    <button class="danger" type="button" role="menuitem" data-action="delete">
      <Trash2 size={15} aria-hidden="true" /> 删除
    </button>
  </div>
</BaseLayout>

<script>
  import { generateGo, generateRust } from "../../lib/json-codegen";

  type JsonPath = (string | number)[];
  type ViewName = "tree" | "rust" | "go";

  const input = document.querySelector<HTMLTextAreaElement>("#json-input");
  const status = document.querySelector<HTMLElement>("#json-status");
  const characters = document.querySelector<HTMLElement>("#json-characters");
  const lines = document.querySelector<HTMLElement>("#json-lines");
  const tree = document.querySelector<HTMLElement>("#json-tree");
  const empty = document.querySelector<HTMLElement>("#viewer-empty");
  const rustOutput = document.querySelector<HTMLElement>("#rust-output");
  const goOutput = document.querySelector<HTMLElement>("#go-output");
  const treeToolbar = document.querySelector<HTMLElement>("#tree-toolbar");
  const contextMenu = document.querySelector<HTMLElement>("#json-context-menu");

  let parsedJson: unknown;
  let hasParsed = false;
  let activeView: ViewName = "tree";
  let selectedPath: JsonPath = [];
  let selectedIsContainer = false;
  // 重建树之前收集已展开节点的 path，编辑后恢复展开状态。
  let openPaths: Set<string> | null = null;

  function setStatus(message: string, state = "") {
    if (!status) return;
    status.textContent = message;
    status.dataset.state = state;
  }

  function updateStats() {
    const value = input?.value ?? "";
    if (characters) characters.textContent = `${value.length.toLocaleString()} 字符`;
    if (lines) lines.textContent = `${value ? value.split("\n").length : 0} 行`;
  }

  function nodeType(value: unknown): string {
    if (value === null) return "null";
    if (Array.isArray(value)) return "array";
    return typeof value;
  }

  function primitiveText(value: unknown): string {
    if (typeof value === "string") return `"${value}"`;
    return String(value);
  }

  function appendProperty(row: HTMLElement, property: string | number | null) {
    if (property === null) return;
    const key = document.createElement("span");
    key.className = "node-key";
    key.textContent = typeof property === "number" ? `[${property}]` : property;
    row.append(key);
  }

  function attachContextMenu(
    row: HTMLElement,
    path: JsonPath,
    isContainer: boolean,
  ) {
    row.addEventListener("contextmenu", (event) => {
      event.preventDefault();
      if (!contextMenu) return;
      selectedPath = path;
      selectedIsContainer = isContainer;
      const edit = contextMenu.querySelector<HTMLElement>('[data-action="edit"]');
      const add = contextMenu.querySelector<HTMLElement>('[data-action="add"]');
      const remove = contextMenu.querySelector<HTMLElement>('[data-action="delete"]');
      if (edit) edit.hidden = isContainer;
      if (add) add.hidden = !isContainer;
      if (remove) remove.hidden = path.length === 0;
      contextMenu.hidden = false;
      const width = contextMenu.offsetWidth;
      const height = contextMenu.offsetHeight;
      contextMenu.style.left = `${Math.min(event.clientX, innerWidth - width - 8)}px`;
      contextMenu.style.top = `${Math.min(event.clientY, innerHeight - height - 8)}px`;
    });
  }

  function createNode(
    value: unknown,
    property: string | number | null,
    path: JsonPath,
    level: number,
  ): HTMLElement {
    const type = nodeType(value);
    const isContainer = type === "object" || type === "array";

    if (!isContainer) {
      const row = document.createElement("div");
      row.className = "json-node-row leaf-row";
      appendProperty(row, property);
      const typeLabel = document.createElement("span");
      typeLabel.className = "node-type";
      typeLabel.textContent = type;
      const content = document.createElement("span");
      content.className = `node-value value-${type}`;
      content.textContent = primitiveText(value);
      row.append(typeLabel, content);
      attachContextMenu(row, path, false);
      return row;
    }

    const details = document.createElement("details");
    details.className = "json-node";
    details.dataset.jsonPath = JSON.stringify(path);
    details.open = openPaths
      ? openPaths.has(JSON.stringify(path))
      : level === 0;
    const summary = document.createElement("summary");
    summary.className = "json-node-row";
    appendProperty(summary, property);

    const keys = Object.keys(value as object);
    const typeLabel = document.createElement("span");
    typeLabel.className = "node-type";
    typeLabel.textContent = type;
    const count = document.createElement("span");
    count.className = "node-count";
    count.textContent = `${type === "array" ? "Array" : "Object"}(${keys.length})`;
    summary.append(typeLabel, count);
    attachContextMenu(summary, path, true);
    details.append(summary);

    const children = document.createElement("div");
    children.className = "json-children";
    if (keys.length === 0) {
      const marker = document.createElement("span");
      marker.className = "empty-container";
      marker.textContent = type === "array" ? "[]" : "{}";
      children.append(marker);
    } else {
      keys.forEach((key, index) => {
        const childProperty = type === "array" ? index : key;
        const childValue = (value as Record<string, unknown>)[key];
        children.append(createNode(childValue, childProperty, [...path, childProperty], level + 1));
      });
    }
    details.append(children);
    return details;
  }

  function renderTree() {
    if (!tree || !empty) return;
    const existing = tree.querySelector("details");
    openPaths = existing
      ? new Set(
          [...tree.querySelectorAll("details")]
            .filter((node) => node.open)
            .map((node) => node.dataset.jsonPath ?? ""),
        )
      : null;
    tree.replaceChildren(createNode(parsedJson, null, [], 0));
    openPaths = null;
    tree.hidden = false;
    empty.hidden = true;
  }

  function rebuildOutputs() {
    if (!hasParsed) return;
    if (rustOutput) rustOutput.textContent = generateRust(parsedJson);
    if (goOutput) goOutput.textContent = generateGo(parsedJson);
    renderTree();
  }

  function parseErrorMessage(error: unknown, source: string): string {
    if (!(error instanceof Error)) return "JSON 无效";
    const position = error.message.match(/position\s+(\d+)/i)?.[1];
    if (!position) return error.message;
    const offset = Number(position);
    const before = source.slice(0, offset);
    const line = before.split("\n").length;
    const column = offset - before.lastIndexOf("\n");
    return `第 ${line} 行，第 ${column} 列：${error.message}`;
  }

  function parseJson() {
    const source = input?.value.trim() ?? "";
    if (!source) return setStatus("请输入 JSON 数据", "error");
    try {
      parsedJson = JSON.parse(source);
      hasParsed = true;
      rebuildOutputs();
      setStatus("JSON 有效", "success");
    } catch (error) {
      hasParsed = false;
      if (tree) tree.hidden = true;
      if (empty) empty.hidden = false;
      setStatus(parseErrorMessage(error, source), "error");
    }
  }

  function getAtPath(path: JsonPath): unknown {
    return path.reduce<unknown>((value, key) => {
      return (value as Record<string | number, unknown>)[key];
    }, parsedJson);
  }

  function getParent(path: JsonPath): Record<string | number, unknown> | unknown[] {
    return getAtPath(path.slice(0, -1)) as Record<string | number, unknown> | unknown[];
  }

  function syncAfterEdit() {
    if (input) input.value = JSON.stringify(parsedJson, null, 2);
    updateStats();
    rebuildOutputs();
    setStatus("节点已更新", "success");
  }

  function convertEditedValue(value: string): unknown {
    try {
      return JSON.parse(value);
    } catch {
      return value;
    }
  }

  contextMenu?.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-action]");
    if (!button) return;
    const action = button.dataset.action;
    contextMenu.hidden = true;
    const current = getAtPath(selectedPath);

    if (action === "copy") {
      const text = JSON.stringify(current, null, 2) ?? String(current);
      try {
        await navigator.clipboard.writeText(text);
        setStatus("节点已复制", "success");
      } catch {
        setStatus("复制失败，请检查剪贴板权限", "error");
      }
      return;
    }

    if (action === "edit" && !selectedIsContainer) {
      const initial = typeof current === "string" ? current : JSON.stringify(current);
      const next = prompt("输入新的值", initial);
      if (next === null) return;
      if (selectedPath.length === 0) parsedJson = convertEditedValue(next);
      else {
        const parent = getParent(selectedPath);
        const key = selectedPath.at(-1)!;
        if (Array.isArray(parent)) parent[Number(key)] = convertEditedValue(next);
        else parent[key] = convertEditedValue(next);
      }
      return syncAfterEdit();
    }

    if (action === "add" && selectedIsContainer) {
      if (Array.isArray(current)) {
        current.push(null);
      } else if (current && typeof current === "object") {
        const key = prompt("输入属性名称");
        if (!key) return;
        (current as Record<string, unknown>)[key] = null;
      }
      return syncAfterEdit();
    }

    if (action === "delete" && selectedPath.length > 0) {
      const parent = getParent(selectedPath);
      const key = selectedPath.at(-1)!;
      if (Array.isArray(parent)) parent.splice(Number(key), 1);
      else delete parent[key];
      syncAfterEdit();
    }
  });

  function hideContextMenu(event: Event) {
    if (contextMenu && !contextMenu.contains(event.target as Node)) contextMenu.hidden = true;
  }

  document.addEventListener("click", hideContextMenu);
  document.addEventListener("scroll", hideContextMenu, true);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && contextMenu) contextMenu.hidden = true;
    if ((event.ctrlKey || event.metaKey) && event.key === "Enter") parseJson();
  });

  document.querySelector("#json-parse")?.addEventListener("click", parseJson);
  input?.addEventListener("input", updateStats);

  document.querySelector("#json-clear")?.addEventListener("click", () => {
    if (input) input.value = "";
    hasParsed = false;
    parsedJson = undefined;
    if (tree) {
      tree.replaceChildren();
      tree.hidden = true;
    }
    if (empty) empty.hidden = false;
    if (rustOutput) rustOutput.textContent = "";
    if (goOutput) goOutput.textContent = "";
    updateStats();
    setStatus("已清空");
    input?.focus();
  });

  document.querySelector("#json-copy-result")?.addEventListener("click", async () => {
    if (!hasParsed) return setStatus("没有可复制的结果", "error");
    const content = activeView === "rust"
      ? rustOutput?.textContent
      : activeView === "go"
        ? goOutput?.textContent
        : JSON.stringify(parsedJson, null, 2);
    try {
      await navigator.clipboard.writeText(content ?? "");
      setStatus("当前视图已复制", "success");
    } catch {
      setStatus("复制失败，请检查剪贴板权限", "error");
    }
  });

  document.querySelector("#expand-all")?.addEventListener("click", () => {
    tree?.querySelectorAll("details").forEach((details) => details.open = true);
  });

  document.querySelector("#collapse-all")?.addEventListener("click", () => {
    tree?.querySelectorAll("details").forEach((details, index) => details.open = index === 0);
  });

  document.querySelectorAll<HTMLButtonElement>(".view-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      activeView = tab.dataset.view as ViewName;
      document.querySelectorAll<HTMLButtonElement>(".view-tab").forEach((item) => {
        const active = item === tab;
        item.classList.toggle("active", active);
        item.setAttribute("aria-selected", String(active));
      });
      document.querySelectorAll<HTMLElement>(".viewer-pane").forEach((pane) => {
        pane.hidden = pane.id !== `${activeView}-pane`;
      });
      if (treeToolbar) treeToolbar.hidden = activeView !== "tree";
    });
  });

  updateStats();
</script>

<style>
  .tool-header {
    margin-bottom: 34px;
  }

  .json-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-block: 14px;
    border-block: 1px solid var(--border);
  }

  .json-toolbar .status-line {
    flex: 1;
    margin-left: 8px;
    text-align: right;
  }

  .viewer-layout {
    display: grid;
    grid-template-columns: minmax(300px, 0.9fr) minmax(420px, 1.1fr);
    gap: 14px;
    padding-top: 18px;
  }

  .input-panel,
  .result-panel {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
  }

  .input-panel {
    display: grid;
    grid-template-rows: auto minmax(460px, 1fr) auto;
  }

  .panel-label {
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .input-panel .textarea {
    min-height: 460px;
    border: 0;
    border-radius: 0;
    background: var(--bg);
    resize: none;
  }

  .input-panel .textarea:focus {
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .input-stats {
    display: flex;
    justify-content: space-between;
    padding: 8px 14px;
    border-top: 1px solid var(--border);
    color: var(--faint);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.7rem;
  }

  .result-panel {
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
  }

  .result-tabs {
    display: flex;
    min-height: 46px;
    align-items: end;
    gap: 2px;
    padding-inline: 10px;
    border-bottom: 1px solid var(--border);
  }

  .view-tab {
    height: 38px;
    padding-inline: 13px;
    border: 0;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    background: transparent;
    cursor: pointer;
    font-size: 0.82rem;
  }

  .view-tab:hover,
  .view-tab.active {
    color: var(--text);
  }

  .view-tab.active {
    border-bottom-color: var(--accent);
  }

  .tree-toolbar {
    display: flex;
    min-height: 38px;
    align-items: center;
    gap: 5px;
    padding-inline: 10px;
    border-bottom: 1px solid var(--border);
    color: var(--faint);
    font-size: 0.7rem;
  }

  .tree-toolbar button {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 7px;
    border: 0;
    border-radius: 4px;
    color: var(--muted);
    background: transparent;
    cursor: pointer;
    font-size: 0.72rem;
  }

  .tree-toolbar button:hover {
    color: var(--text);
    background: var(--surface-raised);
  }

  .tree-toolbar span {
    margin-left: auto;
  }

  .viewer-pane {
    min-height: 460px;
    max-height: 640px;
    overflow: auto;
    margin: 0;
    background: var(--bg);
  }

  .tree-pane {
    padding: 14px;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.8rem;
  }

  .viewer-empty {
    display: grid;
    min-height: 420px;
    place-content: center;
    justify-items: center;
    gap: 10px;
    color: var(--faint);
  }

  .viewer-empty span {
    font-family: inherit;
    font-size: 0.78rem;
  }

  .json-tree :global(details) {
    margin: 0;
  }

  .json-tree :global(summary) {
    list-style-position: outside;
  }

  .json-tree :global(.json-node-row) {
    min-height: 29px;
    align-items: center;
    gap: 8px;
    padding: 3px 7px;
    border-radius: 4px;
    overflow-wrap: anywhere;
  }

  .json-tree :global(summary.json-node-row) {
    display: list-item;
    cursor: pointer;
  }

  .json-tree :global(summary.json-node-row > span) {
    margin-left: 8px;
  }

  .json-tree :global(.leaf-row) {
    display: flex;
    padding-left: 20px;
  }

  .json-tree :global(.json-node-row:hover) {
    background: var(--surface-raised);
  }

  .json-tree :global(.json-children) {
    margin-left: 13px;
    padding-left: 11px;
    border-left: 1px solid var(--border);
  }

  .json-tree :global(.node-key) {
    color: var(--text);
    font-weight: 650;
  }

  .json-tree :global(.node-key::after) {
    content: ":";
    color: var(--faint);
  }

  .json-tree :global(.node-type) {
    padding: 1px 5px;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--faint);
    font-size: 0.64rem;
  }

  .json-tree :global(.node-count),
  .json-tree :global(.empty-container) {
    color: var(--muted);
  }

  .json-tree :global(.value-string) {
    color: var(--accent);
  }

  .json-tree :global(.value-number) {
    color: var(--warm);
  }

  .json-tree :global(.value-boolean) {
    color: var(--muted);
  }

  .json-tree :global(.value-null) {
    color: var(--faint);
    font-style: italic;
  }

  .code-pane {
    padding: 18px;
    color: var(--text);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.8rem;
    line-height: 1.65;
    white-space: pre;
  }

  .context-menu {
    position: fixed;
    z-index: 100;
    width: 148px;
    padding: 5px;
    border: 1px solid var(--border-strong);
    border-radius: 5px;
    background: var(--surface-raised);
    box-shadow: 0 12px 32px rgb(0 0 0 / 36%);
  }

  .context-menu button {
    display: flex;
    width: 100%;
    height: 32px;
    align-items: center;
    gap: 8px;
    padding-inline: 9px;
    border: 0;
    border-radius: 3px;
    color: var(--text);
    background: transparent;
    cursor: pointer;
    font-size: 0.78rem;
    text-align: left;
  }

  .context-menu button:hover {
    background: var(--border-strong);
  }

  .context-menu button.danger {
    color: var(--danger);
  }

  .viewer-pane[hidden],
  .tree-toolbar[hidden],
  .context-menu[hidden],
  .context-menu button[hidden],
  .json-tree[hidden],
  .viewer-empty[hidden] {
    display: none;
  }

  @media (max-width: 820px) {
    .json-toolbar .status-line {
      flex-basis: 100%;
      margin: 3px 0 0;
      text-align: left;
    }

    .viewer-layout {
      grid-template-columns: 1fr;
    }

    .input-panel {
      grid-template-rows: auto 300px auto;
    }

    .input-panel .textarea {
      min-height: 300px;
    }

    .viewer-pane {
      min-height: 380px;
      max-height: 560px;
    }

    .viewer-empty {
      min-height: 340px;
    }
  }

  @media (max-width: 480px) {
    .json-toolbar .tool-button {
      padding-inline: 10px;
      font-size: 0.78rem;
    }

    .tree-toolbar span {
      display: none;
    }
  }
</style>
