---
import { getCollection } from "astro:content";
import ArticleList from "../../../components/ArticleList.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  categoryMeta,
  getArticleCategory,
  sortArticles,
  type ArticleCategory,
} from "../../../lib/articles";

export function getStaticPaths() {
  return (Object.keys(categoryMeta) as ArticleCategory[]).map((category) => ({
    params: { category },
    props: { category },
  }));
}

interface Props {
  category: ArticleCategory;
}

const { category } = Astro.props;
const meta = categoryMeta[category];
const articles = sortArticles(
  (await getCollection("articles", ({ data }) => !data.draft)).filter(
    (article) => getArticleCategory(article) === category,
  ),
);
---

<BaseLayout title={meta.label} description={meta.description} wide>
  <header class="page-header">
    <p class="eyebrow">Articles / {category}</p>
    <h1>{meta.label}</h1>
    <p class="lede">{meta.description}</p>
    <nav class="category-nav" aria-label="文章分类">
      <a href="/articles/">全部</a>
      {
        (Object.keys(categoryMeta) as ArticleCategory[]).map((key) => (
          <a class:list={{ active: key === category }} href={`/articles/${key}/`}>
            {categoryMeta[key].label}
          </a>
        ))
      }
    </nav>
  </header>
  <ArticleList articles={articles} />
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 42px;
  }

  .category-nav {
    display: flex;
    gap: 6px;
    margin-top: 28px;
  }

  .category-nav a {
    padding: 6px 11px;
    border-radius: 4px;
    color: var(--muted);
    font-size: 0.84rem;
    text-decoration: none;
  }

  .category-nav a:hover,
  .category-nav a.active {
    color: var(--text);
    background: var(--surface-raised);
  }
</style>
