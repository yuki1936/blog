---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在" wide>
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>这里什么也没有。</h1>
    <p class="lede">页面可能已经移动，或者从未存在。</p>
    <a class="tool-button" href="/">返回首页</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 720px;
  }

  .not-found .tool-button {
    margin-top: 28px;
    text-decoration: none;
  }
</style>
