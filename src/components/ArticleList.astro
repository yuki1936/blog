---
import type { Article } from "../lib/articles";
import {
  categoryMeta,
  formatDate,
  getArticleCategory,
  getArticleSlug,
} from "../lib/articles";

interface Props {
  articles: Article[];
  emptyText?: string;
}

const { articles, emptyText = "这里还没有文章。" } = Astro.props;
---

{
  articles.length > 0 ? (
    <ol class="article-list">
      {articles.map((article) => {
        const category = getArticleCategory(article);
        return (
          <li>
            <a href={`/articles/${getArticleSlug(article)}/`}>
              <div class="article-meta">
                <span>{categoryMeta[category].label}</span>
                <time datetime={article.data.published.toISOString()}>
                  {formatDate(article.data.published)}
                </time>
              </div>
              <h3 title={article.data.title}>{article.data.title}</h3>
              {article.data.description && <p>{article.data.description}</p>}
            </a>
          </li>
        );
      })}
    </ol>
  ) : (
    <p class="empty-state">{emptyText}</p>
  )
}

<style>
  .article-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-list li {
    border-bottom: 1px solid var(--border);
  }

  .article-list a {
    display: grid;
    gap: 6px;
    padding-block: 18px;
    text-decoration: none;
  }

  .article-list h3 {
    overflow: hidden;
    color: var(--text);
    font-size: 1rem;
    font-weight: 650;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .article-list p {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .article-meta {
    display: flex;
    gap: 12px;
    color: var(--faint);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.73rem;
  }

  .article-meta span {
    color: var(--accent);
  }
</style>
